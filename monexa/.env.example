# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/monexa?schema=public"

# Signs login sessions. Generate your own:  openssl rand -base64 32
# (must be at least 32 characters in production)
AUTH_SECRET="generate-a-random-secret"

# Optional English/Bangla AI command understanding. See docs/voice-assistant.md.
# VOICE_AI_PROVIDER="groq"
# GROQ_API_KEY="your-server-only-key"
# GROQ_VOICE_MODEL="openai/gpt-oss-20b"
# Or use a local model without per-request API fees:
# VOICE_AI_PROVIDER="ollama"
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="qwen3:8b"

# --- Needed in production ---------------------------------------------------
# Public address of the app. Used for password-reset links (never taken from
# the request, so a forged Host header can't poison them).
# APP_URL="https://money.example.com"

# Auth.js must be told to trust the host when not deployed on Vercel.
# AUTH_TRUST_HOST="true"

# --- Password-reset emails ---------------------------------------------------
# Configure ONE option. If both are set, SMTP is used.
# Without either, emails are printed to the console in development only.
# Check the setup with:  npm run email:test -- you@example.com

# Option 1: SMTP, e.g. Gmail (no domain needed, ~500 emails/day).
# SMTP_PASS must be a Gmail *app password* (Google Account > Security >
# 2-Step Verification > App passwords), not your normal password.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="abcd efgh ijkl mnop"
# EMAIL_FROM="Monexa <you@gmail.com>"

# Option 2: Resend (https://resend.com).
# Testing without a domain: use EMAIL_FROM="Monexa <onboarding@resend.dev>".
# Resend then only delivers to the email address you signed up to Resend with.
# For real users, verify your domain at https://resend.com/domains and use an
# address on it, e.g. "Monexa <no-reply@your-domain.com>".
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Monexa <onboarding@resend.dev>"
