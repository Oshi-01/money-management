// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  currency      String    @default("USD")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Copied into each session token at login. Incrementing it (e.g. on password
  // reset) logs out every existing session.
  sessionVersion Int @default(0)

  categories   Category[]
  transactions Transaction[]
  loans        Loan[]
  budgets      Budget[]
  budgetMonths BudgetMonthState[]
  savingsGoals SavingsGoal[]
  accounts     Account[]
}

model Category {
  id        String   @id @default(cuid())
  userId    String?  // Nullable for default system categories
  name      String
  icon      String?
  color     String?
  type      CategoryType

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets   Budget[]

  @@unique([userId, name, type])
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  accountId   String?
  description String
  amount      Float
  type        CategoryType
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Nearly every page lists a user's transactions newest-first, or filters
  // them by category / account. Postgres does not index foreign keys itself.
  @@index([userId, date])
  @@index([categoryId])
  @@index([accountId])
}

model Loan {
  id              String     @id @default(cuid())
  userId          String
  personName      String
  phone           String?
  email           String?
  loanType        LoanType
  principalAmount Float
  interestRate    Float?
  balance         Float
  startDate       DateTime
  dueDate         DateTime?
  status          LoanStatus @default(ACTIVE)
  notes           String?
  includeInTotal  Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repayments  Repayment[]
  activities  LoanActivity[]

  @@index([userId])
}

enum LoanType {
  BORROWED
  LENT
}

enum LoanStatus {
  ACTIVE
  PAID
  OVERDUE
}

enum LoanActivityType {
  CREATED
  ADDITION
  ADJUSTMENT
}

model LoanActivity {
  id           String           @id @default(cuid())
  loanId       String
  type         LoanActivityType
  amountDelta  Float
  balanceAfter Float
  activityDate DateTime
  notes        String?
  createdAt    DateTime         @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, activityDate])
}

model Repayment {
  id          String   @id @default(cuid())
  loanId      String
  amount      Float
  paymentDate DateTime
  notes       String?
  createdAt   DateTime @default(now())

  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  month      String   // Format: YYYY-MM
  amount     Float
  showOnDashboard Boolean @default(false)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  // The budgets page and carry-over look budgets up by (user, month).
  @@index([userId, month])
  @@index([categoryId])
}

// Records that a month has already been initialized. This keeps an intentionally
// emptied month from being populated again by automatic budget carry-over.
model BudgetMonthState {
  id            String   @id @default(cuid())
  userId        String
  month         String
  initializedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
}

model SavingsGoal {
  id           String    @id @default(cuid())
  userId       String
  title        String
  targetAmount Float
  savedAmount  Float     @default(0)
  deadline     DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   // e.g., 'Primary', 'Credit', 'Digital'
  prefix    String?  // e.g., '**** 4587' or email
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

/// Attempt counters for rate limiting (see lib/rate-limit.ts). Stored in the
/// database so the limit holds across several server instances.
model RateLimit {
  key     String   @id // e.g. "login:email:someone@example.com"
  count   Int
  resetAt DateTime // when the current window ends

  @@index([resetAt]) // lets the periodic clean-up find expired rows fast
}
